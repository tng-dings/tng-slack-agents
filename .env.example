# Copy to the git-ignored .env; npm run dev/doctor/smoke/discord:register load it.
# Uncomment only the names the selected executor and enabled integrations need.
# Leave the rest commented out: an empty value is not the same as unset.

# executor: "claude-code" — one of these two
#ANTHROPIC_API_KEY=
#CLAUDE_CODE_OAUTH_TOKEN=

# executor: "opencode" — same password as the opencode serve terminal
#OPENCODE_SERVER_PASSWORD=

# slack.enabled: true
#SLACK_BOT_TOKEN=xoxb-
# slack.ingress: "socket"
#SLACK_APP_TOKEN=xapp-
# slack.ingress: "events-api"
#SLACK_SIGNING_SECRET=

# discord.enabled: true
#DISCORD_BOT_TOKEN=
# discord.ingress: "http" — 64-character hex Ed25519 key
#DISCORD_PUBLIC_KEY=

# Optional: alternate config.json path
#AGENT_RUNNER_CONFIG=
