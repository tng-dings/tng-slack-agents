{
  "name": "self-hosted-slack-agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "start": "node dist/index.js",
    "smoke": "tsx src/cli/smoke.ts",
    "test": "npm run build && node --test --test-isolation=none --test-concurrency=1 dist/test/opencode.test.js dist/test/runner.test.js"
  },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "@slack/web-api": "^7.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
